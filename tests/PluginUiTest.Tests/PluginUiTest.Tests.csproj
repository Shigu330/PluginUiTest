<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pure parts of PluginUiTest (command line and refusals, report, Dalamud and game paths) and, since 0.2.0, its game-memory scan
       (MemoryScan, CallGraph) read on ScanFixtures.cs of this assembly with Mono.Cecil from Dalamud's distribution (DALAMUD_HOME, else
       Hooks\dev; copied into this test output only, never shipped): dotnet run on this project prints each case and exits 1 on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><PlatformTarget>x64</PlatformTarget>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and '$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/PluginUiTest.Host/DalamudPaths.cs;../../src/PluginUiTest.Host/CallGraph.cs;../../src/PluginUiTest/Options.cs;../../src/PluginUiTest/Report.cs;../../src/PluginUiTest/MemoryScan.cs" Link="Linked/%(Filename)%(Extension)" />
    <Reference Include="Mono.Cecil"><HintPath>$(DalamudLibPath)Mono.Cecil.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
